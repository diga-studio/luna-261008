{
  "name": "substitute-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "In-process substitute-part inventory aggregation library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
