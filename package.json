{
  "name": "leadpulse",
  "version": "0.1.0",
  "description": "In-memory lead scoring library with time decay and rewritable event weights",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "bench": "tsc -p tsconfig.bench.json && node --expose-gc dist-bench/bench/perf.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  }
}
